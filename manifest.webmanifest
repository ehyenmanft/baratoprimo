{
  "name": "BaratoPrimo — inventario y facturación",
  "short_name": "BaratoPrimo",
  "description": "Gestión de inventario, ventas y facturación para comercios.",
  "lang": "es",
  "dir": "ltr",

  "start_url": "./index.html",
  "scope": "./",
  "id": "baratoprimo",

  "display": "standalone",
  "orientation": "any",
  "background_color": "#131020",
  "theme_color": "#6C3BF4",

  "icons": [
    { "src": "img/icono-64.png",  "sizes": "64x64",   "type": "image/png" },
    { "src": "img/icono-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "img/icono-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "img/icono-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "img/icono-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "img/logo.svg", "sizes": "any", "type": "image/svg+xml" }
  ],

  "shortcuts": [
    {
      "name": "Nueva venta",
      "short_name": "Vender",
      "url": "./index.html#/ventas/nueva",
      "icons": [{ "src": "img/icono-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Productos",
      "short_name": "Productos",
      "url": "./index.html#/productos",
      "icons": [{ "src": "img/icono-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Movimientos",
      "short_name": "Kardex",
      "url": "./index.html#/movimientos",
      "icons": [{ "src": "img/icono-192.png", "sizes": "192x192" }]
    }
  ],

  "categories": ["business", "productivity", "finance"]
}
